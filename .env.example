# ---------------------------------------------------------------------------
# JobShield AI - example environment file
#
# Copy this file to ".env" and fill in real values:
#     Copy-Item .env.example .env
#
# NEVER commit the real ".env" file. It is already listed in .gitignore.
# ---------------------------------------------------------------------------

# Secret key used to sign cookies and CSRF tokens.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Local environment. Vercel is automatically treated as production.
# Set FLASK_ENV=production explicitly on other production hosts.
FLASK_ENV=development

# 1 turns on Flask debug mode. Keep it 0 for anything public.
FLASK_DEBUG=0

# Leave blank locally to use the SQLite file in the "instance" folder.
# Example for Render (PostgreSQL):
#     DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Folder holding the trained model and its metadata.
ARTIFACTS_DIR=artifacts

# true  -> save the pasted job description so it can be shown again in history
# false -> save only the metadata, prediction and warning findings
STORE_JOB_DESCRIPTION=true

# Largest request body accepted, in bytes (default 512 KB).
MAX_CONTENT_LENGTH=524288

# Your public repository link, shown in the navbar.
# Leave blank while you have no repository yet.
GITHUB_URL=

# Must be true in production (HTTPS only). Keep false for http://localhost.
SESSION_COOKIE_SECURE=false

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
